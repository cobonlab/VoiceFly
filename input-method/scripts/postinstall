#!/bin/bash

set -euo pipefail

if [ -n "${DSTROOT:-}" ]; then
    input_methods_root="${DSTROOT%/}"
else
    install_volume="${3:-/}"
    input_methods_root="${install_volume%/}/Library/Input Methods"
fi

login_user="$(/usr/bin/stat -f%Su /dev/console)"
has_login_user=1
if [ -z "${login_user}" ] || [ "${login_user}" = root ] || [ "${login_user}" = loginwindow ]; then
    has_login_user=0
fi

voicefly_app_root="${input_methods_root}/VoiceFly.app"
voicefly_executable="${voicefly_app_root}/Contents/MacOS/VoiceFlyInput"
if [ ! -x "${voicefly_executable}" ]; then
    echo >&2 "ERROR: installed VoiceFly executable is missing: ${voicefly_executable}"
    exit 1
fi

run_as_login_user() {
    if [ "$(/usr/bin/id -un)" = "${login_user}" ]; then
        "$@"
    elif [ "$(/usr/bin/id -u)" = 0 ]; then
        /usr/bin/sudo -u "${login_user}" "$@"
    else
        echo >&2 "ERROR: activation must run as ${login_user} or root."
        return 1
    fi
}

if [ "${has_login_user}" -eq 0 ]; then
    echo 'VoiceFly files were installed, but TIS registration and activation require a GUI login.'
    echo 'After login, run the following commands as that user:'
    printf "  '%s' --register-input-source\n" "${voicefly_executable}"
    printf "  '%s' --build\n" "${voicefly_executable}"
    printf "  '%s' --enable-input-source\n" "${voicefly_executable}"
    echo 'Save work, log out of macOS, then select Voice Fly using the native input-source menu after login.'
    exit 0
fi

run_as_login_user "${voicefly_executable}" --register-input-source

if [ -z "${RIME_NO_PREBUILD:-}" ]; then
    run_as_login_user "${voicefly_executable}" --build
fi

run_as_login_user "${voicefly_executable}" --enable-input-source

# Replacing the input-method process can strand an in-flight recording if its
# final distributed stop notification is lost during shutdown.  Start every
# newly installed input method with a clean voice-service state.
voice_service_label="com.simonli.voicefly.service"
login_uid="$(/usr/bin/id -u "${login_user}")"
if ! run_as_login_user /bin/launchctl kickstart -k "gui/${login_uid}/${voice_service_label}"; then
    echo >&2 "WARNING: unable to restart VoiceFlyService; voice input may need a manual service restart."
fi

echo 'Save work, log out of macOS, then select Voice Fly using the native input-source menu after login.'
