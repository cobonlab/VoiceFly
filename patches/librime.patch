+bool Selector::PreviousRow(Context* ctx) {
+  if (row_size_ == 0)
+    return false;
+  Composition& comp = ctx->composition();
+  if (comp.empty())
+    return false;
+  int index = comp.back().selected_index;
+  if (index < row_size_)
+    return true;
+  ctx->Highlight(index - row_size_);
+  comp.back().tags.insert("paging");
+  return true;
+}
+
+bool Selector::NextRow(Context* ctx) {
+  if (row_size_ == 0)
+    return false;
+  Composition& comp = ctx->composition();
+  if (comp.empty() || !comp.back().menu)
+    return false;
+  int index = comp.back().selected_index + row_size_;
+  int candidate_count = comp.back().menu->Prepare(index + 1);
+  if (candidate_count <= index)
+    return true;
+  ctx->Highlight(index);
+  comp.back().tags.insert("paging");
+  return true;
+}
