#!/bin/bash
# encoding: utf-8

set -euo pipefail

DEV_ID="${1-}"
DERIVED_DATA_PATH_ARGUMENT="${2-}"
if [ -z "${DEV_ID}" ]; then
    echo >&2 'ERROR: Developer ID must not be empty.'
    exit 64
fi

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
source "${script_dir}/common.sh"
derived_data_root="$(resolve_derived_data_path "${DERIVED_DATA_PATH_ARGUMENT}")"
app_dir="${derived_data_root}/Build/Products/Release/VoiceFlypy.app"
entitlement="${PROJECT_ROOT}/resources/Squirrel.entitlements"

if [ ! -d "${app_dir}" ] || [ ! -x "${app_dir}/Contents/MacOS/Squirrel" ]; then
    echo >&2 "ERROR: invalid VoiceFlypy release app: ${app_dir}"
    exit 1
fi

actual_bundle_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "${app_dir}/Contents/Info.plist")"
actual_executable="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "${app_dir}/Contents/Info.plist")"
if [ "${actual_bundle_identifier}" != 'com.simonli.inputmethod.VoiceFlypy' ] || [ "${actual_executable}" != 'Squirrel' ]; then
    echo >&2 "ERROR: refusing to sign unexpected identity ${actual_bundle_identifier}/${actual_executable}."
    exit 1
fi

/usr/bin/codesign --deep --force --options runtime --timestamp \
    --sign "Developer ID Application: ${DEV_ID}" \
    --entitlements "${entitlement}" \
    --verbose "${app_dir}"

/usr/sbin/spctl -a -vv "${app_dir}"
