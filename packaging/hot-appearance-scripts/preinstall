#!/bin/bash
set -euo pipefail
state='/Library/Application Support/VoiceFly Hot Appearance Installer'
user=$(/usr/bin/stat -f%Su /dev/console)
[[ "$3" == / && "$user" != root && "$user" != loginwindow && -n "$user" ]] || exit 1
user_home=$(/usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory | /usr/bin/sed 's/^NFSHomeDirectory: //')
uid=$(/usr/bin/id -u "$user")
user_tmp=$(/usr/bin/sudo -u "$user" /usr/bin/getconf DARWIN_USER_TEMP_DIR)
as_user() { /usr/bin/sudo -u "$user" /usr/bin/env HOME="$user_home" TMPDIR="$user_tmp" "$@"; }
script_dir=$(/usr/bin/dirname "$0")
front='/Library/Input Methods/VoiceFly.app'
settings='/Applications/Voice Fly.app'
[[ ! -L "$front" && ! -L "$settings" ]] || exit 1
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$front/Contents/Info.plist")" == com.simonli.inputmethod.VoiceFly ]] || exit 1
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$settings/Contents/Info.plist")" == com.simonli.voicefly.settings ]] || exit 1
as_user "$script_dir/voicefly-update-probe" --ready || { echo 'Finish typing/dictation and select ABC before updating.' >&2; exit 1; }
/bin/mkdir -p "$state"; /bin/chmod 700 "$state"
[[ ! -e "$state/current" ]] || exit 1
backup="$user_home/Library/Application Support/VoiceFly/Backups/hot-logo-$(/bin/date +%Y%m%d-%H%M%S)"
[[ ! -L "$user_home/Library/Application Support/VoiceFly/Backups" && ! -e "$backup" ]] || exit 1
/bin/mkdir -m 700 "$backup"
/usr/sbin/chown "$uid" "$backup"
as_user "$front/Contents/MacOS/VoiceFlyInput" --quit
for attempt in {1..10}; do
 if ! /usr/bin/pgrep -u "$uid" -x VoiceFlyInput >/dev/null; then break; fi
 /bin/sleep 1
done
if /usr/bin/pgrep -u "$uid" -x VoiceFlyInput >/dev/null; then echo 'Input method did not exit; existing apps are untouched.' >&2; exit 1; fi
# Recheck after graceful exit; never strand a recording when replacing the host.
as_user "$script_dir/voicefly-update-probe" --ready
/usr/bin/pkill -u "$uid" -x VoiceFlySettings || true
/usr/bin/printf '%s\n%s\n%s\n' "$user" "$user_home" "$backup" > "$state/current"
/bin/chmod 600 "$state/current"
# Move whole bundles, so removed resources cannot survive as unsealed residue.
/bin/mv "$front" "$backup/replaced-input.app"
if ! /bin/mv "$settings" "$backup/replaced-settings.app"; then
 /bin/mv "$backup/replaced-input.app" "$front"
 /bin/mv "$state/current" "$backup/failed-before-install"
 exit 1
fi
